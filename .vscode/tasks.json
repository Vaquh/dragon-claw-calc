{
  "tasks": [
    {
      "label": "DEBUG",
      "detail": "",
      "type": "cppbuild",
      "command": "g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-Wall",
        "-Weffc++",
        "-Wextra",
        "-Wconversion",
        "-Wsign-conversion",
        "-Werror",
        "-ggdb",
        "-Og",
        "-std=c++23",
        "-pedantic-errors",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      } 
    },
    {
      "label": "RELEASE",
      "detail": "",
      "type": "cppbuild",
      "command": "g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-O2",
        "-DNDEBUG",
        "-std=c++23",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      } 
    }
  ],
  "version": "2.0.0"
}